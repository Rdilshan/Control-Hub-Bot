APP_NAME="Control Hub"
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000

# PostgreSQL (Async engine via asyncpg)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/control_hub
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30

# Redis Connection
REDIS_URL=redis://localhost:6379/0

# Telegram Bot Integration
CONTROL_HUB_BOT_TOKEN=
PLATFORM_OWNER_TELEGRAM_ID=
BOT_TOKEN_ENCRYPTION_KEY=dGVzdF9mZXJuZXRfa2V5XzMyX2J5dGVzX2xlbmd0aF8xMjM=

# Logging Level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# Webhook and Internal Security
TELEGRAM_WEBHOOK_BASE_URL=
TELEGRAM_WEBHOOK_SECRET=
INTERNAL_API_SECRET=
